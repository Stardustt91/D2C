# Copy this file to .env and fill in your own values. Do NOT commit .env.
#
# Everything is read through agents/env_config.py, which loads this file at import
# time. API keys are REQUIRED: the app fails at startup naming the missing variable
# rather than dying later inside an LLM call. Endpoints, deployment names and API
# versions are optional and fall back to the values shown as comments below.

# --- Azure OpenAI: chat tier -------------------------------------------------
# gpt-4o-mini. The cheap structure-generation steps: cost drivers, components,
# inputs, and deduplication.
AZURE_OPENAI_CHAT_API_KEY=
AZURE_OPENAI_CHAT_ENDPOINT=          # default: https://ds-openai-4omini-v01.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_CHAT_API_VERSION=       # default: 2024-08-01-preview

# --- Azure OpenAI: reasoning tier --------------------------------------------
# gpt-5. The steps that must deliberate: resource planner, cost parameters, cost
# estimation, and the pricing engine. Its API version differs from the chat tier's
# and is deliberately kept separate — sharing one version downgrades this deployment.
AZURE_OPENAI_REASONING_API_KEY=
AZURE_OPENAI_REASONING_ENDPOINT=     # default: https://ds-openai-v01.openai.azure.com/
AZURE_OPENAI_REASONING_DEPLOYMENT=gpt-5
AZURE_OPENAI_REASONING_API_VERSION=  # default: 2024-12-01-preview

# --- Azure OpenAI: resource planner override ---------------------------------
# The plan runs once per project, so a stronger deployment pays for itself in
# estimation quality. Any variable set here overrides the reasoning tier for the
# planner alone; anything left blank falls back to it.
AZURE_OPENAI_PLANNER_DEPLOYMENT=
AZURE_OPENAI_PLANNER_ENDPOINT=
AZURE_OPENAI_PLANNER_API_KEY=
AZURE_OPENAI_PLANNER_REASONING_EFFORT=   # default: low

# --- Azure OpenAI: conversation tier -----------------------------------------
# gpt-5.2-chat. Every turn of the AI Assistant's intake interview: classifying the
# service, extracting facts, deciding what to ask next, reading the analyst's verdict
# on the draft. The only model in the system with a person waiting on the other end,
# so it is chosen for latency and judgement together and kept off the tiers whose
# tuning is driven by batch cost.
#
# Reached through the Azure AI Services v1 API, which takes a base URL and a model
# name rather than an endpoint, a deployment and an API version.
AZURE_OPENAI_CONVERSATION_API_KEY=
AZURE_OPENAI_CONVERSATION_BASE_URL=  # default: https://mwaheed-v01-resource.services.ai.azure.com/openai/v1/
AZURE_OPENAI_CONVERSATION_MODEL=gpt-5.2-chat

# --- Azure OpenAI: writer tier -----------------------------------------------
# gpt-5. The activity description the interview ends on, and the rewrites made to it
# during review. It runs once, and the whole cost estimate is built from its output.
# Every variable defaults to the reasoning tier's, including the key — by default this
# IS that deployment. Set them only to move the write-up somewhere else.
AZURE_OPENAI_WRITER_API_KEY=         # default: the reasoning tier's key
AZURE_OPENAI_WRITER_ENDPOINT=        # default: the reasoning tier's endpoint
AZURE_OPENAI_WRITER_DEPLOYMENT=      # default: the reasoning tier's deployment
AZURE_OPENAI_WRITER_API_VERSION=     # default: the reasoning tier's API version

# --- Azure OpenAI: embeddings ------------------------------------------------
# text-embedding-3-large. The FAISS stores in new_vector_dbs/ were built with this
# model and will not match anything else.
AZURE_OPENAI_EMBEDDINGS_API_KEY=
AZURE_OPENAI_EMBEDDINGS_ENDPOINT=    # default: https://ds-embed-v01.openai.azure.com
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDINGS_API_VERSION= # default: 2024-08-01-preview

# Fallback API version for the chat and embeddings tiers when the per-tier variable
# above is blank. It is NOT applied to the reasoning tier.
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Tavily (web search) -----------------------------------------------------
# Required: the search-backed pricing paths cannot run without it.
TAVILY_API_KEY=

# --- ExchangeRate API (live currency conversion) -----------------------------
# Optional. Left blank, pricing_fx skips the live lookup and uses its embedded
# fallback rate table, flagging every converted figure as a fallback rate.
EXCHANGERATE_API_KEY=
